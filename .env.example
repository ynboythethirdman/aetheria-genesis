# ── Minecraft Server ──
MC_HOST=your-server-ip
MC_PORT=25565
MC_VERSION=1.20.4

# ── Agent Fleet ──
AGENT_COUNT=100
SPAWN_DELAY_MS=2000
TICK_INTERVAL_MS=10000

# ── LLM Provider (groq or openrouter) ──
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-or-openrouter-api-key
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.9

# ── Memory (Upstash Redis) ──
UPSTASH_REDIS_URL=your-upstash-redis-url
UPSTASH_REDIS_TOKEN=your-upstash-redis-token

# ── Dashboard ──
DASHBOARD_PORT=3000

# ══════════════════════════════════════════════════════════════════════
# VIBE SQUAD — Roblox Bot Companions
# ══════════════════════════════════════════════════════════════════════

# ── Roblox Game ──
ROBLOX_GAME_URL=https://www.roblox.com/games/YOUR_GAME_ID
ROBLOX_OWNER=T0rzyz

# ── Bot Credentials (optional — bots auto-create accounts if none provided) ──
# Option 1: .ROBLOSECURITY cookies (if you have existing accounts)
# ROBLOX_COOKIE_1=your-roblosecurity-cookie-for-zachy_vibs
# ROBLOX_COOKIE_2=your-roblosecurity-cookie-for-luna_sky7
# ROBLOX_COOKIE_3=your-roblosecurity-cookie-for-not_jason
#
# Option 2: username/password auth
# ROBLOX_USER_1=zachy_vibs
# ROBLOX_PASS_1=password1
# ROBLOX_USER_2=luna_sky7
# ROBLOX_PASS_2=password2
# ROBLOX_USER_3=not_jason
# ROBLOX_PASS_3=password3
#
# Option 3: Leave all blank — bots will auto-create new Roblox accounts
# (may need manual CAPTCHA solve on first run)

# ── Squad Behavior Tuning ──
TETHER_RADIUS=15
TETHER_MIN_DIST=3
SQUAD_TICK_MS=3000
CHAT_COOLDOWN_MS=8000
TYPING_WPM_MIN=40
TYPING_WPM_MAX=60
HUMAN_ERROR_CHANCE=0.08
REJOIN_DELAY_MS=180000

# ── Vibe Squad Dashboard ──
VIBE_DASHBOARD_PORT=3001
